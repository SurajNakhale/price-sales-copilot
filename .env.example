# Copy to .env.local and fill in. See README.md for the Google Cloud setup steps.

# OAuth client of type "Web application" (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match a redirect URI registered on that OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional: comma-separated sender addresses. Empty means any sender.
# SENDER_ALLOWLIST=sales@brand-one.com,pricing@brand-two.com
